{
  "name": "mine-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:desktop": "vite build --mode desktop --outDir ../desktop/dist --emptyOutDir && node -e \"for (const f of ['formats.json','sites.json']) require('fs').copyFileSync('../desktop/data/'+f,'../desktop/dist/'+f)\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "socket.io-client": "^4.8.0",
    "@tauri-apps/api": "^2.12.0"
  }
}
