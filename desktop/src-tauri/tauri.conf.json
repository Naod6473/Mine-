{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mine",
  "mainBinaryName": "mine",
  "version": "1.0.1",
  "identifier": "io.github.naod6473.mine",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm --prefix ../ui run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mine!?",
        "width": 1040,
        "height": 720,
        "minWidth": 420,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Colle un lien, la mouette récupère le fichier.",
    "longDescription": "Mine!? télécharge des vidéos, de la musique, des sous-titres ou des miniatures depuis YouTube et plus de mille sites, grâce à yt-dlp. Les fichiers arrivent dans ton dossier Téléchargements.",
    "copyright": "Les auteurs de Mine!?, AGPL-3.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["French", "English"] } },
    "linux": { "deb": { "depends": [] } }
  }
}
